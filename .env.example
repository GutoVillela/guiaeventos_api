# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCP_PROJECT_ID=guia-eventos
GCP_BUCKET_NAME=images-guia-eventos
GCP_SA_PRIVATE_KEY_ID=
GCP_SA_PRIVATE_KEY=
GCP_SA_CLIENT_EMAIL=
GCP_SA_CLIENT_ID=
GCP_SA_CLIENT_X509_CERT_URL=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=nao-responderguiaeventosescolares@festou.com.br
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=nao-responderguiaeventosescolares@festou.com.br
EMAIL_FROM_NAME=Guia Evento Escolar
